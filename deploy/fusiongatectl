#!/usr/bin/env bash
set -Eeuo pipefail

FUSIONGATE_HOME="${FUSIONGATE_HOME:-/opt/fusiongate}"
APP_DIR="$FUSIONGATE_HOME/app"
COMPOSE_FILE="$APP_DIR/deploy/compose.production.yml"
COMPOSE_ENV="$FUSIONGATE_HOME/config/compose.env"
BACKUP_DIR="${FUSIONGATE_BACKUP_DIR:-/var/backups/fusiongate}"

compose() {
  docker compose --project-directory "$APP_DIR" --env-file "$COMPOSE_ENV" -f "$COMPOSE_FILE" "$@"
}

verify_services() {
  compose exec -T fusiongate /usr/local/bin/fusiongate-healthcheck >/dev/null
}

recreate_runtime() {
  compose up -d --force-recreate fusiongate quality-detector
  for _ in $(seq 1 30); do
    if verify_services; then
      return 0
    fi
    sleep 2
  done
  echo "FusionGate or its quality detector did not become ready" >&2
  return 1
}

verify_database() {
  local database="$1" result
  result="$(sqlite3 "$database" 'PRAGMA quick_check; PRAGMA foreign_key_check;')"
  [[ "$result" == "ok" ]] || {
    echo "Database integrity check failed: $result" >&2
    return 1
  }
}

require_install() {
  [[ -f "$FUSIONGATE_HOME/.fusiongate-install" && -f "$COMPOSE_FILE" ]] || {
    echo "FusionGate is not installed at $FUSIONGATE_HOME" >&2
    exit 1
  }
}

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || {
    echo "This command requires root. Use: sudo fusiongatectl $*" >&2
    exit 1
  }
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  start|stop)
    require_root "$cmd"
    require_install
    compose "$cmd"
    ;;
  restart)
    require_root "$cmd"
    require_install
    recreate_runtime
    ;;
  status)
    require_install
    compose ps
    ;;
  logs)
    require_install
    compose logs -f --tail "${1:-200}"
    ;;
  health)
    require_install
    domain="$(sed -n 's/^FUSIONGATE_DOMAIN=//p' "$COMPOSE_ENV" | head -1)"
    curl -fsS "https://${domain}/healthz?include=quality-detector"
    echo
    ;;
  update)
    require_root "$cmd"
    require_install
    exec "$APP_DIR/deploy/install.sh" --update
    ;;
  backup)
    require_root "$cmd"
    require_install
    install -d -m 0700 "$BACKUP_DIR"
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive="$BACKUP_DIR/fusiongate-$stamp.tar.gz"
    compose stop quality-detector fusiongate
    trap 'compose start fusiongate quality-detector >/dev/null 2>&1 || true' EXIT
    verify_database "$FUSIONGATE_HOME/data/fusiongate.db"
    tar -C "$FUSIONGATE_HOME" -czf "$archive" data quality-detector-data config .fusiongate-install
    chmod 0600 "$archive"
    sha256sum "$archive" > "$archive.sha256"
    chmod 0600 "$archive.sha256"
    compose start fusiongate quality-detector
    trap - EXIT
    echo "$archive"
    ;;
  restore)
    require_root "$cmd"
    require_install
    archive="${1:-}"
    [[ -f "$archive" ]] || { echo "Backup archive not found: $archive" >&2; exit 1; }
    [[ -f "$archive.sha256" ]] || { echo "Missing checksum: $archive.sha256" >&2; exit 1; }
    sha256sum -c "$archive.sha256"
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    tar -tzf "$archive" | grep -qx 'data/fusiongate.db'
    tar -xzf "$archive" -C "$work"
    verify_database "$work/data/fusiongate.db"
    safety="$BACKUP_DIR/pre-restore-$(date -u +%Y%m%dT%H%M%SZ)"
    install -d -m 0700 "$safety"
    compose stop quality-detector fusiongate
    trap 'compose start fusiongate quality-detector >/dev/null 2>&1 || true; rm -rf "$work"' EXIT
    mv "$FUSIONGATE_HOME/data" "$safety/data"
    mv "$FUSIONGATE_HOME/config" "$safety/config"
    if [[ -d "$FUSIONGATE_HOME/quality-detector-data" ]]; then
      mv "$FUSIONGATE_HOME/quality-detector-data" "$safety/quality-detector-data"
    fi
    mv "$work/data" "$FUSIONGATE_HOME/data"
    mv "$work/config" "$FUSIONGATE_HOME/config"
    if [[ -d "$work/quality-detector-data" ]]; then
      mv "$work/quality-detector-data" "$FUSIONGATE_HOME/quality-detector-data"
    else
      install -d -m 0700 "$FUSIONGATE_HOME/quality-detector-data"
    fi
    chown -R 10001:10001 "$FUSIONGATE_HOME/data"
    chown -R 10002:10002 "$FUSIONGATE_HOME/quality-detector-data"
    chmod 0700 "$FUSIONGATE_HOME/data" "$FUSIONGATE_HOME/quality-detector-data" "$FUSIONGATE_HOME/config"
    compose start fusiongate quality-detector
    for _ in $(seq 1 30); do
      if verify_services; then
        trap - EXIT
        rm -rf "$work"
        echo "Restored $archive; previous data preserved at $safety"
        exit 0
      fi
      sleep 2
    done
    compose stop quality-detector fusiongate >/dev/null 2>&1 || true
    mv "$FUSIONGATE_HOME/data" "$safety/failed-data"
    mv "$FUSIONGATE_HOME/config" "$safety/failed-config"
    mv "$FUSIONGATE_HOME/quality-detector-data" "$safety/failed-quality-detector-data"
    mv "$safety/data" "$FUSIONGATE_HOME/data"
    mv "$safety/config" "$FUSIONGATE_HOME/config"
    if [[ -d "$safety/quality-detector-data" ]]; then
      mv "$safety/quality-detector-data" "$FUSIONGATE_HOME/quality-detector-data"
    fi
    compose start fusiongate quality-detector
    echo "Restore did not become ready; the previous installation was restored. Failed restore is at $safety" >&2
    exit 1
    ;;
  help|*)
    cat <<'USAGE'
Usage: fusiongatectl <command>

Commands:
  status          Show container status
  health          Check the public HTTPS health endpoint
  logs [lines]    Follow logs (default: last 200 lines)
  start|stop      Start or stop services
  restart         Restart services
  update          Download the configured GitHub ref and rebuild
  backup          Create and checksum a protected backup
  restore FILE    Verify and restore a backup, preserving current data
USAGE
    ;;
esac
