{
    servers {
        timeouts {
            # Caddy 2.11.6 can re-arm the request read deadline after EOF in
            # HTTP/1 reverse_proxy, canceling an active SSE response at 60s.
            # Keep a hard upload ceiling, not the faulty idle wrapper.
            read_body_idle -1s
            read_body 3m
            read_header 15s
        }
    }
}

{$FUSIONGATE_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    reverse_proxy fusiongate:8787 {
        flush_interval -1
        transport http {
            dial_timeout 10s
        }
    }

    log {
        output stdout
        format json
    }
}
