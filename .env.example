# Generate with: openssl rand -base64 32
FUSIONGATE_MASTER_KEY=replace_with_32_byte_base64_key
# Use a unique high-entropy password. It is PBKDF2-HMAC-SHA256 hashed at first boot.
FUSIONGATE_ADMIN_PASSWORD=replace_with_a_long_unique_password
# Production deployments may set FUSIONGATE_MASTER_KEY_FILE and
# FUSIONGATE_ADMIN_PASSWORD_FILE instead of placing secrets in the environment.
# Safe default: bind admin + API gateway to localhost. Put Caddy/Nginx/VPN in front if remotely accessed.
FUSIONGATE_ADDR=127.0.0.1:8787
FUSIONGATE_DATA_DIR=./data
# Protect the process from retry storms and excessive long-lived upstream work.
# FUSIONGATE_MAX_FAILOVER_ATTEMPTS=8
# FUSIONGATE_MAX_CONCURRENT_REQUESTS=64
# Streaming first-byte and token-idle limits. Use Go duration syntax.
# FUSIONGATE_STREAM_START_TIMEOUT=12s
# FUSIONGATE_STREAM_IDLE_TIMEOUT=5m
# Optional comma-separated browser origin allowlist. Empty keeps the legacy wildcard behavior.
# FUSIONGATE_CORS_ORIGINS=https://app.example.com,https://console.example.com
# Refresh official model prices every hour. Values below 5m fall back to 1h; set 0/off/false to disable.
FUSIONGATE_PRICING_SYNC_INTERVAL=1h
# Background OAuth model-list connectivity checks only; per-provider health_check_enabled still applies.
# FUSIONGATE_HEALTH_CHECK_INTERVAL=15m
# FUSIONGATE_HEALTH_CHECK_CONCURRENCY=5
# Grok OAuth upstream compatibility metadata. Override only if the upstream changes its minimum client version.
# FUSIONGATE_GROK_CLI_VERSION=0.2.111
# Development-only opt-ins. Do not enable for a public deployment.
# FUSIONGATE_ALLOW_INSECURE_UPSTREAMS=false
# FUSIONGATE_ALLOW_PRIVATE_UPSTREAMS=false
# Only needed for source installs that enable IP pool nodes; Docker images include sing-box.
# FUSIONGATE_SING_BOX_PATH=/usr/local/bin/sing-box
